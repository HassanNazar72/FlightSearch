# Copy to .env for local development. Django loads it automatically (python-dotenv).
# In production (Render) set these as real environment variables instead.

# Set DJANGO_DEBUG=0 in production; then DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins (your Vercel URL in production, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173

PROVIDER_TIMEOUT_SECONDS=1.5
SEARCH_CACHE_TTL=300
SEARCH_CACHE_TTL_PARTIAL=60
SEARCH_RATE_LIMIT=60/min

# 1 = five mock providers fail/hang on purpose (shows graceful degradation)
MOCK_CHAOS_ENABLED=1
